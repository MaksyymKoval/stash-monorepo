{
  "name": "@stash/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "auth:generate": "auth generate --config src/modules/auth/auth.ts --output src/modules/auth/better-auth.schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.20",
    "@better-auth/expo": "1.7.20",
    "@stash/contracts": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-node": "12.4.2",
    "better-auth": "1.7.20",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "auth": "1.7.20",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
