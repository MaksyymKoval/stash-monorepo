{
  "expo": {
    "name": "Stash",
    "slug": "stash",
    "scheme": "stash",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.unlockyourstash.app",
      "appleTeamId": "3R47XS2WDC",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stash використовує фото, щоб додати косметику з фото столу й опублікувати образ.",
          "cameraPermission": "Stash використовує камеру, щоб сфотографувати косметику чи образ."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
